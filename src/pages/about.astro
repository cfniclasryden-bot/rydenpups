---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
---
<Base
  title="About rydenpups · Luna & Stella · Dubai"
  description="Meet Luna & Stella — two Dubai dogs creating real, funny, aesthetic content for pet brands. Golden retriever + cocker spaniel duo from the UAE."
  current="about"
>
  <section class="band about" style="background:var(--cream);">
    <span class="star" style="top:50px;right:8%;">✦</span>
    <div class="wrap">
      <div class="rev" style="text-align:center;">
        <span class="kicker">Who we are</span>
        <h2 class="sec-h">About Luna &amp; Stella</h2>
      </div>
      <div class="about-grid">
        <div class="about-polas rev">
          <span class="star" style="top:-12px;left:8%;">✦</span>
          <span class="heart-deco" style="bottom:10px;right:6%;font-size:1.4rem;">♡</span>
          <div class="polaroid" style="position:relative;width:78%;margin:30px auto 0;transform:rotate(-4deg);">
            <span class="tape" style="top:-14px;left:38%;transform:rotate(-8deg);"></span>
            <img src="/p-luna.jpg" alt="Luna and Stella together" style="height:auto;aspect-ratio:640/755;object-fit:cover;" />
            <span class="cap">the duo ♡</span>
          </div>
        </div>
        <div class="about-text rev">
          <p class="lead">Real dogs. Real chaos. Real personality.</p>
          <p>We're <span class="hl">Luna &amp; Stella</span> — two Dubai girls creating content for brands we genuinely love. No overly polished studio vibe. No fake influencer energy.</p>
          <p>Just real dog moments: crumbs on the floor, dramatic side-eyes, snack obsession, zoomies and way too much personality.</p>
          <p>We create <span class="hl">aesthetic but relatable</span> pet content that actually feels alive — the kind every dog parent sees a little of their own pup in.</p>
          <p>We're based in <span class="hl">Dubai, UAE</span> 🇦🇪 and work with pet food, treat, accessory, grooming and lifestyle brands across the Middle East and worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band meet" style="background:var(--pink);">
    <div class="checker"></div>
    <div class="wrap">
      <div class="rev" style="text-align:center;">
        <span class="kicker">The talent ✨</span>
        <h2 class="sec-h">Meet the girls</h2>
      </div>
      <div class="girls">
        <div class="girl-card luna rev">
          <div class="pola-wrap">
            <div class="polaroid" style="height:260px;">
              <span class="tape" style="top:-13px;left:32%;transform:rotate(-8deg);"></span>
              <img src="/m-luna.jpg" alt="Luna the golden retriever" />
              <span class="cap">our Luna ♡</span>
            </div>
          </div>
          <div class="emoji-name">🌞 Luna</div>
          <div class="tag">Golden retriever · professional snack tester<br>· ASMR chewing expert</div>
          <p class="blurb">Luna is all about funny silly faces, chaotic golden retriever energy, satisfying crunch content, treat reactions and big expressive emotions on camera. She's our food-focused UGC star.</p>
        </div>
        <div class="girl-card stella rev">
          <div class="pola-wrap">
            <div class="polaroid" style="height:260px;">
              <span class="tape" style="top:-13px;left:32%;transform:rotate(7deg);background:rgba(217,201,240,.8);"></span>
              <img src="/m-stella.jpg" alt="Stella the cocker spaniel" />
              <span class="cap">our Stella ♡</span>
            </div>
          </div>
          <div class="emoji-name">🎀 Stella</div>
          <div class="tag">Soft lady energy with the tiniest<br>bit of diva behavior</div>
          <p class="blurb">Stella brings fashion &amp; aesthetic vibes, luxury soft-girl content, calm pretty visuals, elegant product moments and pure main character puppy energy to every shoot.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band cta" style="background:var(--pink);">
    <div class="checker"></div>
    <div class="wrap">
      <div class="cta-card rev">
        <h2>Want to work with us?</h2>
        <p class="sub">We're always open to new partnerships.</p>
        <div class="cta-btns">
          <a href="https://instagram.com/rydenpups" target="_blank" rel="noopener" class="btn btn-1">📸 DM us @rydenpups</a>
          <a href="mailto:rydenpups@gmail.com" class="btn btn-2">✉️ Email us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
